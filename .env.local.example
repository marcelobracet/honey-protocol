# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployment (no trailing slash). Used in e-mails, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Company details shown in the footer and legal pages (LGPD requires identifying the controller).
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ID=            # CNPJ / VAT
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_GUARANTEE_DAYS=7

# ---------------------------------------------------------------------------
# Database (Postgres). On Vercel: Storage → Neon → Connect, which sets DATABASE_URL.
# Locally: paste the pooled connection string. Then run `npm run db:migrate`.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sessions — random string, at least 32 chars. Generate: `openssl rand -base64 48`
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Stripe — the source of truth for access when selling through KashPay, which
# charges via your own Stripe account. Webhook URL:
#   https://<domain>/api/webhooks/stripe
# Subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
#               charge.refunded, charge.dispute.created, charge.dispute.closed
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Query parameter the checkout expects the buyer's language under. KashPay and
# other Stripe front-ends forward unknown parameters into the Checkout Session
# metadata, where the webhook reads it. Use "xcod" when selling via Hotmart.
NEXT_PUBLIC_CHECKOUT_LOCALE_PARAM=lang

# ---------------------------------------------------------------------------
# Hotmart — optional, only if you also sell there. The Stripe webhook above
# covers KashPay; this one covers Hotmart. Both can run side by side.
# ---------------------------------------------------------------------------
# Hotmart → Tools → Webhook (v2.0) → URL: https://<your-domain>/api/webhooks/hotmart
HOTMART_HOTTOK=
# Optional: comma-separated product ids/ucodes to accept (empty = accept all)
HOTMART_PRODUCT_IDS=

# Checkout links. CHECKOUT_URL is the default; per-locale overrides win when set.
CHECKOUT_URL=https://pay.hotmart.com/XXXXXXXX
CHECKOUT_URL_PT=
CHECKOUT_URL_EN=
CHECKOUT_URL_ES=
CHECKOUT_URL_FR=
CHECKOUT_URL_IT=
CHECKOUT_URL_DE=

# Display prices on the sales page (text, shown as-is). Leave empty to hide.
PRICE_PT=
PRICE_EN=
PRICE_ES=
PRICE_FR=
PRICE_IT=
PRICE_DE=
# Optional crossed-out anchor price per locale
ANCHOR_PRICE_PT=
ANCHOR_PRICE_EN=

# ---------------------------------------------------------------------------
# E-mail (Resend). Without these, e-mails are printed to the console in dev.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Truque do Mel <acesso@seudominio.com>"

# ---------------------------------------------------------------------------
# Cron (Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/reminders)
# ---------------------------------------------------------------------------
CRON_SECRET=

# Local-time window (inclusive) in which the morning reminder may be sent.
# Default 5-21 suits the once-a-day cron that Hobby plans allow. On Pro, switch
# vercel.json to "0 * * * *" and set this to 7-8 for breakfast-time delivery.
REMINDER_LOCAL_HOURS=5-21

# ---------------------------------------------------------------------------
# Meta (optional). Pixel loads only after cookie consent. CAPI sends server-side
# Purchase events from the Hotmart webhook.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# Google Analytics 4 (optional). Loads only after cookie consent. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Back redirect (optional): where the browser Back button sends visitors from the
# sales page (e.g. the VSL or a recovery offer). Per-locale overrides win when set.
BACK_REDIRECT_URL=
BACK_REDIRECT_URL_EN=

# VSL page (/{locale}/vsl). Video: iframe embed URL (YouTube, Vimeo, Vturb...) or a direct .mp4.
# The checkout button appears after VSL_CTA_DELAY_SECONDS (0 = immediately). Per-locale overrides win.
VSL_VIDEO_URL=
VSL_VIDEO_URL_EN=
VSL_CTA_DELAY_SECONDS=0

# Return URL: point the Stripe Checkout success_url (or KashPay's thank-you page) at
#   https://<domain>/api/checkout/return?session_id={CHECKOUT_SESSION_ID}
# That signs the buyer in on the spot, so getting access never depends on e-mail.
# Without the session id it still works, but the buyer has to request a link.
# For Hotmart, use https://<domain>/{locale}/thank-you instead; it appends
# ?email=...&transaction=..., used to prefill the resend form and deduplicate the pixel event.
