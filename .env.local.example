# Cloudflare Access (Zero Trust) — see README.md for setup steps.
# Leave both unset for local dev: proxy.ts skips the auth check when they're missing.

# Your Zero Trust team domain, e.g. "yourteam.cloudflareaccess.com"
CF_ACCESS_TEAM_DOMAIN=

# The Access application's "Audience" (AUD) tag, from the Access dashboard
CF_ACCESS_AUD=
